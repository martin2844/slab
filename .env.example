# Slab Configuration

# REST API
PORT=6970
# Required: generate with `openssl rand -hex 32`
TRACKER_API_KEY=

# Keep loopback-only when using a reverse proxy on the VPS.
BIND_ADDRESS=127.0.0.1

# MCP Server
TRACKER_MCP_PORT=6969
TRACKER_MCP_MODE=http

# Database (defaults to ./slab.db)
TRACKER_DB_PATH=./slab.db
